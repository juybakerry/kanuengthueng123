# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ห้ามแชร์ให้ใคร และไม่ถูกอัปขึ้น GitHub)
# บน Render ให้ใส่ค่าเหล่านี้ในหน้า Environment ของ service แทน

# ฐานข้อมูล PostgreSQL (เว้นว่าง = เก็บในโฟลเดอร์ data/ ของเครื่องนี้)
# Supabase: Connect › Session pooler › URI แล้วแทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูล
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# รหัส PIN สำหรับพนักงาน (ต้องตั้งถ้าเปิดผ่านอินเทอร์เน็ต)
# ADMIN_PIN=

# LINE Official Account (Messaging API)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_TO=            # (ไม่บังคับ) userId/groupId ที่รับแจ้งเตือนเสมอ คั่นด้วยจุลภาค · ปกติใช้การพิมพ์ "ลงทะเบียน <PIN>" ใน LINE แทน

# พอร์ต (ค่าเริ่มต้น 8787 สำหรับ npm start, 5173 สำหรับ npm run dev)
# PORT=8787

# เวลาของเซิร์ฟเวอร์ (บนโฮสต์ต่างประเทศต้องตั้ง)
# TZ=Asia/Bangkok
